  m_Name: 
  m_EditorClassIdentifier: 
  outline: {fileID: 4436349841883906042}
  isInteractable: 1
  canMove: 0
  canRotate: 1
  data: {fileID: 11400000, guid: c100ada7789d7df45a12ce9f30b97f00, type: 2}
  startAnimIndex: 0
  animator: {fileID: 2975801688637483488}
  isDialoguer: 0
  isMazeMiser: 1
  isComentarist: 1
  dialogue:
    name: Avaro
    sentences:
    - "Mu\xE9strame el camino \xA1Oh t\xFA, quien conserva la sabidur\xEDa!\r"
    - "El peso agobia mi juicio; mu\xE9strame hacia d\xF3nde debo empujar.\r"
    - "Empujar\xE9 seg\xFAn tu voluntad; dime tan s\xF3lo el lugar.\r\r"
    - "Aqu\xED me encuentro p\xE9rdido y agotado; iluminame t\xFA, quien recorre
      el camino de la salvaci\xF3n.\r\r\r"
    - "Acatar\xE9 tu mandato; s\xF3lo te ruego que me recuerdes si alcanzas el perd\xF3n.\r\r\r\r"
    - "\xA1S\xE1lvanos!, pues de tu victoria seremos parte.\r\r\r\r\r"
    - "\xA1Ten piedad de nosotros!, que en tu haza\xF1a dejamos nuestra huella.\r\r\r\r\r\r"
  _trailSpawnPoint: {fileID: 6738055797064238756}
